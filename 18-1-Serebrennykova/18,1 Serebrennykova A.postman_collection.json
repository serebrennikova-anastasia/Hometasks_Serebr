			"item": [
				{
					"name": "Is Valid ISBN13 Number + tests",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test(\"Status code is 200\", function () {\r",
									"    pm.response.to.have.status(200);\r",
									"});\r",
									"\r",
									"\r",
									"pm.test(\"Body contains IsValidISBN13Result\", function () {\r",
									"    pm.expect(pm.response.text()).to.include(\"IsValidISBN13Result\");\r",
									"});\r",
									"\r",
									"\r",
									"pm.test(\"Content-Type is text/xml\", function () {\r",
									"    pm.response.to.have.header(\"Content-Type\", \"text/xml; charset=utf-8\");\r",
									"});\r",
									"\r",
									"\r",
									"pm.test(\"ISBN13 is valid\", function () {\r",
									"    pm.expect(pm.response.text()).to.include(\"true\");\r",
									"});\r",
									"\r",
									"\r",
									"pm.test(\"Response has soap:Envelope\", function () {\r",
									"    pm.expect(pm.response.text()).to.include(\"soap:Envelope\");\r",
									"});\r",
									"\r",
									"\r",
									"pm.test(\"Response body length > 0\", function () {\r",
									"    pm.expect(pm.response.text().length).to.be.above(0);\r",
									"});\r",
									"\r",
									"\r",
									"pm.test(\"Response time < 2s\", function () {\r",
									"    pm.expect(pm.response.responseTime).to.be.below(2000);\r",
									"});\r",
									"\r",
									"\r",
									"pm.test(\"Response has OK status text\", function () {\r",
									"    pm.response.to.have.status(\"OK\");\r",
									"});\r",
									"\r",
									"\r",
									"pm.test(\"Response contains soap:Body\", function () {\r",
									"    pm.expect(pm.response.text()).to.include(\"soap:Body\");\r",
									"});\r",
									"\r",
									"\r",
									"pm.test(\"Response has no fault\", function () {\r",
									"    pm.expect(pm.response.text()).to.not.include(\"soap:Fault\");\r",
									"});\r",
									""
